# Salin menjadi .env.local (server lokal) atau isi di Vercel -> Project Settings -> Environment Variables.
# Jangan pernah commit file berisi nilai asli.

# --- Wajib: basis data Supabase utama (Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Settings -> API -> JWT Settings -> JWT Secret (dipakai untuk token akses basis data per user)
SUPABASE_JWT_SECRET=

# --- Wajib: lisensi dari penyedia platform ---
LISENSI_KUNCI=

# --- Wajib bila memakai jadwal otomatis (cron) ---
# Acak minimal 32 karakter: openssl rand -hex 32
CRON_SECRET=

# --- Alamat publik platform (dipakai di tautan notifikasi & bagikan) ---
NEXT_PUBLIC_APP_URL=https://wm.perusahaan-anda.com

# --- Opsional: integrasi ---
FONNTE_TOKEN=
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
MONITOR_TOKEN=

# --- Opsional: basis data kedua untuk Team Services ---
NEXT_PUBLIC_SUPABASE_SERVICES_URL=
NEXT_PUBLIC_SUPABASE_SERVICES_ANON_KEY=
SUPABASE_SERVICES_SERVICE_ROLE_KEY=

# --- Opsional: pendaftaran akun dengan kode undangan ---
REGISTER_BYPASS_ENABLED=
REGISTER_BYPASS_CODE=
REGISTER_BYPASS_UNTIL=

# --- Opsional: true = tolak jalan tanpa SUPABASE_SERVICE_ROLE_KEY ---
REQUIRE_SERVICE_ROLE=
